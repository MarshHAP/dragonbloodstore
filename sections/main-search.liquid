<section class="page">
  <div class="container">
    <h1 class="section-title">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter" style="max-width:480px;margin:0 auto 2rem">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}" style="border:1px solid #e6d9dc">
      <button class="btn btn--primary" type="submit">{{ 'general.search.title' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p style="text-align:center">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <div class="testimonial-grid product-grid">
          {%- paginate search.results by 12 -%}
            {%- for item in search.results -%}
              <a class="review-card product-card" href="{{ item.url }}">
                {%- if item.featured_image -%}
                  {{ item.featured_image | image_url: width: 600 | image_tag: alt: item.title, class: 'product-card__img' }}
                {%- elsif item.image -%}
                  {{ item.image | image_url: width: 600 | image_tag: alt: item.title, class: 'product-card__img' }}
                {%- endif -%}
                <h3>{{ item.title }}</h3>
                {%- if item.price -%}<p><b>{{ item.price | money }}</b></p>{%- endif -%}
              </a>
            {%- endfor -%}
            {%- if paginate.pages > 1 -%}
              <div class="pagination">
                {%- if paginate.previous -%}<a class="btn btn--ghost" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
                {%- if paginate.next -%}<a class="btn btn--ghost" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
