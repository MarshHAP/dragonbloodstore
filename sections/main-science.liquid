<!-- Science hero -->
<section class="hero">
  <div class="container">
    <div class="hero__banner hero__banner--science">
      {%- if section.settings.hero_image -%}
        {{ section.settings.hero_image | image_url: width: 2000 | image_tag: class: 'hero__photo hero__photo--plain', alt: 'Dragon blood trees' }}
      {%- else -%}
        <img class="hero__photo hero__photo--plain" src="{{ 'tree-3.jpg' | asset_url }}" alt="Dragon blood trees with umbrella-shaped crowns on a rocky plateau" width="1086" height="1448">
      {%- endif -%}
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__content">
        <p class="sci-eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p class="hero__sub">{{ section.settings.subheading }}</p>
        <a href="{{ section.settings.cta_link | default: '/#offer' }}" class="btn btn--primary">{{ section.settings.cta_label }} <u>Risk-Free</u></a>
      </div>
    </div>
  </div>
</section>

<!-- What is it -->
<section class="sci-split">
  <div class="container sci-split__grid">
    <div class="sci-split__copy">
      {{ section.settings.intro_content }}
    </div>
    <figure class="sci-figure">
      {%- if section.settings.intro_image -%}
        {{ section.settings.intro_image | image_url: width: 1100 | image_tag: alt: 'Dragon blood tree' }}
      {%- else -%}
        <img src="{{ 'tree-2.jpg' | asset_url }}" alt="Looking up the pale trunk of a dragon blood tree into its dense green crown" width="1086" height="1448">
      {%- endif -%}
      <figcaption>{{ section.settings.intro_caption }}</figcaption>
    </figure>
  </div>
</section>

<!-- Where it grows -->
<section class="sci-split sci-split--tinted">
  <div class="container sci-split__grid">
    <figure class="sci-figure sci-figure--square">
      {%- if section.settings.map_image -%}
        {{ section.settings.map_image | image_url: width: 1200 | image_tag: alt: 'Map of where the dragon blood tree grows' }}
      {%- else -%}
        <img src="{{ 'tree-map.jpg' | asset_url }}" alt="Map of China highlighting Yunnan province, home of the dragon blood tree" width="1200" height="1200">
      {%- endif -%}
      <figcaption>{{ section.settings.map_caption }}</figcaption>
    </figure>
    <div class="sci-split__copy">
      {{ section.settings.map_content }}
    </div>
  </div>
</section>

<!-- Stats + biology -->
<section class="sci-stats">
  <div class="container">
    <h2 class="section-title">{{ section.settings.stats_heading }}</h2>
    <div class="sci-stats__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="sci-stat" {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="sci-split__grid sci-split__grid--rev">
      <figure class="sci-figure">
        {%- if section.settings.biology_image -%}
          {{ section.settings.biology_image | image_url: width: 1100 | image_tag: alt: 'Dragon blood tree canopy' }}
        {%- else -%}
          <img src="{{ 'tree-1.jpg' | asset_url }}" alt="The lattice of branches inside a dragon blood tree canopy, seen from below" width="1086" height="1448">
        {%- endif -%}
        <figcaption>{{ section.settings.biology_caption }}</figcaption>
      </figure>
      <div class="sci-split__copy">
        {{ section.settings.biology_content }}
      </div>
    </div>
  </div>
</section>

<!-- Resin timeline -->
<section class="sci-resin">
  <div class="container">
    <h2 class="section-title">{{ section.settings.resin_heading }}</h2>
    <p class="sci-lead">{{ section.settings.resin_lead }}</p>
    <div class="sci-timeline">
      {%- for block in section.blocks -%}
        {%- if block.type == 'era' -%}
          <div class="sci-era" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- What's in it -->
<section class="sci-benefits">
  <div class="container">
    <h2 class="section-title">{{ section.settings.compounds_heading }}</h2>
    <p class="sci-lead">{{ section.settings.compounds_lead }}</p>
    <div class="benefit-cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'compound' -%}
          <div class="benefit-tile" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- Skin barrier -->
<section class="sci-split sci-split--tinted">
  <div class="container sci-split__grid">
    <figure class="sci-figure sci-figure--square">
      {%- if section.settings.barrier_image -%}
        {{ section.settings.barrier_image | image_url: width: 1100 | image_tag: alt: 'Dragon blood resin' }}
      {%- else -%}
        <img src="{{ 'serum-extract.jpg' | asset_url }}" alt="Deep red dragon's blood resin beside the serum bottle" width="1100" height="1100">
      {%- endif -%}
      <figcaption>{{ section.settings.barrier_caption }}</figcaption>
    </figure>
    <div class="sci-split__copy">
      {{ section.settings.barrier_content }}
    </div>
  </div>
</section>

<!-- Skin benefits -->
<section class="sci-benefits">
  <div class="container">
    <h2 class="section-title">{{ section.settings.benefits_heading }}</h2>
    <p class="sci-lead">{{ section.settings.benefits_lead }}</p>
    <div class="benefit-cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <div class="benefit-tile" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- Gentle by nature -->
<section class="sci-benefits">
  <div class="container">
    <h2 class="section-title">{{ section.settings.gentle_heading }}</h2>
    <p class="sci-lead">{{ section.settings.gentle_lead }}</p>
  </div>
</section>

<!-- From tree to bottle -->
<section class="sci-split sci-split--tinted">
  <div class="container sci-split__grid">
    <div class="sci-split__copy">
      {{ section.settings.formula_content }}
      <a href="{{ section.settings.cta_link | default: '/#offer' }}" class="btn btn--primary">{{ section.settings.cta_label }} <u>Risk-Free</u></a>
    </div>
    <figure class="sci-figure">
      {%- if section.settings.formula_image -%}
        {{ section.settings.formula_image | image_url: width: 1100 | image_tag: alt: 'Dragon blood trees' }}
      {%- else -%}
        <img src="{{ 'tree-4.jpg' | asset_url }}" alt="Dragon blood trees on a sunlit rocky hillside beneath a spiny canopy" width="1086" height="1448">
      {%- endif -%}
      <figcaption>{{ section.settings.formula_caption }}</figcaption>
    </figure>
  </div>
</section>

{%- if section.settings.sources_text != blank -%}
<!-- Sources / disclaimer -->
<section class="sci-sources">
  <div class="container"><p>{{ section.settings.sources_text }}</p></div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Science page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Falls back to the bundled tree photo." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Science" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Tree That Bleeds Red" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "An ancient resin, backed by modern research - meet the tree whose crimson \"dragon's blood\" powers every bottle of Dragonblood® serum." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Try Dragonblood" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Intro" },
    { "type": "richtext", "id": "intro_content", "label": "Intro content", "default": "<h2>What Is Dragon's Blood?</h2><p>Dragon's blood isn't a marketing name. It's the traditional name for the deep red resin tapped from the bark of a handful of remarkable trees - from <em>Croton lechleri</em> in the Amazon rainforest and <em>Daemonorops draco</em> in Southeast Asia to the <em>Dracaena</em> dragon trees of Asia. For centuries, communities have applied the sap directly to cuts, burns and irritated skin to protect it and speed healing - and today, dermatology and cosmetic science are catching up with what traditional medicine already knew.</p><p>Dragon blood trees belong to <em>Dracaena</em> - a genus of 60 to 100 species, of which only a handful grow into true trees. A stout trunk is crowned by a dense, upturned umbrella of stiff, sword-like leaves.</p><p>Cut the bark, and the tree appears to bleed. A deep crimson resin seeps from the wound - the legendary <strong>dragon's blood</strong> that gives these trees their name and has been prized for thousands of years.</p><p><strong>Our serum is based on the species found in southern China</strong> - <em>Dracaena cochinchinensis</em>, the Chinese dragon blood tree. It grows on limestone hills across Yunnan and neighbouring regions, and its resin has centuries of history in traditional Chinese practice.</p>" },
    { "type": "image_picker", "id": "intro_image", "label": "Intro image" },
    { "type": "text", "id": "intro_caption", "label": "Intro caption", "default": "The dense, umbrella-shaped crown - a signature of tree-form Dracaena." },
    { "type": "header", "content": "Where it grows" },
    { "type": "image_picker", "id": "map_image", "label": "Map image", "info": "Falls back to the bundled Yunnan map." },
    { "type": "text", "id": "map_caption", "label": "Map caption", "default": "Yunnan, southern China - home of our dragon blood trees." },
    { "type": "richtext", "id": "map_content", "label": "Where-it-grows content", "default": "<h2>Where Our Trees Grow</h2><p>Our dragon blood trees come from <strong>Yunnan province in southern China</strong> - a high, sun-drenched region of limestone hills and red-earth plateaus on the edge of the Himalayas.</p><p>Yunnan is one of the most botanically rich places on Earth, and it has a deep connection to this tree. Near Kunming, on the famous red earth of Dongchuan, stands a revered ancient dragon tree believed to be around a thousand years old - honoured by local villagers as a symbol of vitality and protection, and now under formal judicial protection.</p><p>It's this landscape - and this species, <em>Dracaena cochinchinensis</em> - that our dragon blood extract is based on.</p>" },
    { "type": "header", "content": "Biology" },
    { "type": "text", "id": "stats_heading", "label": "Stats heading", "default": "A Tree Unlike Any Other" },
    { "type": "richtext", "id": "biology_content", "label": "Biology content", "default": "<h2>Built for Survival</h2><p>Dragon blood trees are monocots - botanical cousins of palms and grasses - yet unlike almost all of their relatives, their trunks thicken year after year through a rare form of secondary growth.</p><p>Every branch splits into two identical limbs, a pattern called dichotomous branching. Repeated over centuries, it produces the tree's iconic dome: a tight lattice of branches tipped with rosettes of leathery, water-conserving leaves.</p><p>That umbrella crown shades the roots, captures moisture from mist and cloud, and lets the species thrive where few other trees survive at all. This hardiness - a metabolism built around protection and repair - is what makes the tree's resin so interesting for skin.</p>" },
    { "type": "image_picker", "id": "biology_image", "label": "Biology image" },
    { "type": "text", "id": "biology_caption", "label": "Biology caption", "default": "Inside the canopy: each branch divides in two, again and again." },
    { "type": "header", "content": "Resin timeline" },
    { "type": "text", "id": "resin_heading", "label": "Resin heading", "default": "The Crimson Resin" },
    { "type": "textarea", "id": "resin_lead", "label": "Resin lead", "default": "When the bark is wounded, the tree seals the cut with a rich red resin - its own natural repair system, tapped for millennia without felling the tree. This is not a trend ingredient: what's changed isn't the resin, it's our ability to isolate and study the compounds responsible for what it does." },
    { "type": "header", "content": "What's in it" },
    { "type": "text", "id": "compounds_heading", "label": "Compounds heading", "default": "What's Actually in It" },
    { "type": "textarea", "id": "compounds_lead", "label": "Compounds lead", "default": "The resin isn't a single \"active\" - it's a concentrated mix of plant compounds, several of which have documented effects on skin." },
    { "type": "header", "content": "Skin barrier" },
    { "type": "image_picker", "id": "barrier_image", "label": "Barrier image", "info": "Falls back to the bundled resin photo." },
    { "type": "text", "id": "barrier_caption", "label": "Barrier caption", "default": "The resin itself - a concentrated mix of protective plant compounds." },
    { "type": "richtext", "id": "barrier_content", "label": "Barrier content", "default": "<h2>What This Means for Your Skin Barrier</h2><p>Your skin's barrier is the outermost layer that keeps moisture in and irritants out. When it's compromised - by over-exfoliation, harsh actives, weather, or simply age - skin gets reactive, dehydrated and dull faster.</p><p>Dragon's blood extract is studied for its ability to support that barrier function directly: helping reduce water loss through the skin, calming visible redness and irritation, and giving skin the conditions it needs to repair itself.</p><p><strong>That's why it works as a daily layer rather than an occasional treatment</strong> - it supports a process instead of masking a symptom.</p>" },
    { "type": "header", "content": "Gentle by nature" },
    { "type": "text", "id": "gentle_heading", "label": "Gentle heading", "default": "Gentle by Nature" },
    { "type": "textarea", "id": "gentle_lead", "label": "Gentle lead", "default": "Unlike retinoids or high-strength acids, dragon's blood extract is considered a gentle ingredient with a low irritation profile - which is part of why it suits sensitive, reactive and compromised skin as well as normal skin. As with any new ingredient, patch test before full use, particularly if you have a latex sensitivity, since the resin shares some botanical similarity with natural latex." },
    { "type": "header", "content": "Sources" },
    { "type": "textarea", "id": "sources_text", "label": "Sources / disclaimer", "default": "Sources: Skincare.com (L'Oréal), \"The Skin-Care Benefits of Dragon's Blood\"; Clinikally, \"Dragon's Blood Resin: The Ancient Skin Protector Making a Modern Comeback\". This page is for educational purposes and reflects general ingredient research; individual results vary. Always patch test new products and consult a dermatologist for specific skin concerns." },
    { "type": "header", "content": "Skin benefits" },
    { "type": "text", "id": "benefits_heading", "label": "Benefits heading", "default": "What It Does for Skin" },
    { "type": "textarea", "id": "benefits_lead", "label": "Benefits lead", "default": "Modern research into dragon's blood resin points to the same theme the tree itself embodies: protection and repair." },
    { "type": "header", "content": "Formula" },
    { "type": "richtext", "id": "formula_content", "label": "Formula content", "default": "<h2>From Tree to Bottle</h2><p><strong>The takeaway:</strong> dragon's blood works because of what's actually in it - antioxidant-rich proanthocyanidins, repair-supporting taspine, and a broader phenolic profile that together calm, protect and help skin recover its own barrier function. Every drop of our formula starts there, paired with ceramide NP, a skin-identical lipid that helps repair and stabilise the barrier, and glossy ganoderma, a deeply moisturising mushroom extract.</p><p><em>Dragon trees grow slowly, and some island species are considered vulnerable. Our extract is based on the cultivated southern-China species - tapped from the bark, never felled.</em></p>" },
    { "type": "image_picker", "id": "formula_image", "label": "Formula image" },
    { "type": "text", "id": "formula_caption", "label": "Formula caption", "default": "Slow-growing and long-lived - the resin is collected without harming the tree." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat tile",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "1000+" },
        { "type": "text", "id": "label", "label": "Label", "default": "years - ages reached by the oldest dragon trees" }
      ]
    },
    {
      "type": "era",
      "name": "Timeline era",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Ancient world" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Traded across the Mediterranean and Arabia as a precious dye, incense and remedy." }
      ]
    },
    {
      "type": "compound",
      "name": "Compound card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Proanthocyanidins" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The majority of the resin's dry weight. Potent antioxidants that help neutralise the free radicals generated by UV exposure, pollution and everyday environmental stress." }
      ]
    },
    {
      "type": "benefit",
      "name": "Skin benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Supports the skin barrier" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Resin compounds help reinforce skin's natural protective layer and support its recovery." }
      ]
    }
  ],
  "presets": [{ "name": "Science page" }]
}
{% endschema %}
