{%- assign icon_shield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="20" height="20"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>' -%}
{%- assign icon_drop = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="20" height="20"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>' -%}
{%- assign icon_sparkle = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="20" height="20"><path d="M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2 2-6Z"/></svg>' -%}
{%- assign icon_leaf = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="20" height="20"><path d="M5 19C5 9 12 4 20 4c0 8-5 15-15 15Z"/><path d="M5 19c3-5 7-8 11-10"/></svg>' -%}

<section class="benefits">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <div class="benefits__grid">
      <div class="benefits__list" id="benefitsList">
        {%- for block in section.blocks -%}
          <button class="benefit-row{% if forloop.first %} is-active{% endif %}" data-benefit="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="benefit-row__head">
              <span class="benefit-row__icon">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}{{ icon_shield }}
                  {%- when 'drop' -%}{{ icon_drop }}
                  {%- when 'sparkle' -%}{{ icon_sparkle }}
                  {%- else -%}{{ icon_leaf }}
                {%- endcase -%}
              </span>
              {{ block.settings.title }}
            </span>
            <span class="benefit-row__body">{{ block.settings.text }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div class="benefits__media">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image.alt }}
        {%- else -%}
          <img src="{{ 'serum-extract.jpg' | asset_url }}" alt="Dragon blood tree - the source of dragon blood extract" width="880" height="880">
        {%- endif -%}
      </div>
    </div>
    <div class="section-cta">
      <a href="#offer" class="btn btn--primary js-scroll">{{ section.settings.button_label }} <u>Risk-Free</u></a>
      <div class="guarantee-pill guarantee-pill--light">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>
        {{ settings.guarantee_text }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Benefits of Using Dragonblood" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the bundled dragon blood tree photo." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try Dragonblood" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "drop", "label": "Drop" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Repairs the Skin Barrier" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Dragon blood extract and ceramide NP help strengthen and repair your skin's natural protective barrier." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefits accordion",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit", "settings": { "icon": "drop", "title": "Deep, Lasting Hydration", "text": "Glossy ganoderma deeply moisturises, so skin stays plump and comfortable from morning to night." } },
        { "type": "benefit", "settings": { "icon": "sparkle", "title": "Brightens & Evens Tone", "text": "A focused botanical formula that helps fade dullness and bring back a healthy, even glow." } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "A Simple Botanical Formula", "text": "Lightweight, fast-absorbing and gentle enough for daily use - a few drops, morning and night." } }
      ]
    }
  ]
}
{% endschema %}
