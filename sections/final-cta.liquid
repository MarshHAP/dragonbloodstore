<section class="guarantee">
  <div class="container">
    <div class="guarantee__card guarantee__card--trees">
      <div class="rotator js-rotator" aria-hidden="true">
        {%- assign has_slides = false -%}
        {%- for block in section.blocks -%}
          {%- assign has_slides = true -%}
          {%- if forloop.first -%}{%- assign slide_class = 'is-active' -%}{%- else -%}{%- assign slide_class = '' -%}{%- endif -%}
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: class: slide_class, alt: '', loading: 'lazy' }}
          {%- else -%}
            <img src="{{ block.settings.fallback_image | asset_url }}" alt="" {% if forloop.first %}class="is-active"{% endif %} loading="lazy" {{ block.shopify_attributes }}>
          {%- endif -%}
        {%- endfor -%}
        {%- unless has_slides -%}
          <img src="{{ 'tree-1.jpg' | asset_url }}" alt="" class="is-active" loading="lazy">
          <img src="{{ 'tree-2.jpg' | asset_url }}" alt="" loading="lazy">
          <img src="{{ 'tree-3.jpg' | asset_url }}" alt="" loading="lazy">
          <img src="{{ 'tree-4.jpg' | asset_url }}" alt="" loading="lazy">
        {%- endunless -%}
      </div>
      <div class="guarantee__overlay">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <a href="#offer" class="btn btn--primary js-scroll">{{ section.settings.button_label }} <u>Risk-Free</u></a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try Dragonblood" },
    { "type": "text", "id": "text", "label": "Text", "default": "A simple daily ritual for your skin, backed by our 30-Day Money-Back Guarantee." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try Dragonblood" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Rotating image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Fallback asset filename", "default": "tree-1.jpg", "info": "Used when no image is picked." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Final CTA",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "fallback_image": "tree-2.jpg" } },
        { "type": "slide", "settings": { "fallback_image": "tree-3.jpg" } },
        { "type": "slide", "settings": { "fallback_image": "tree-4.jpg" } }
      ]
    }
  ]
}
{% endschema %}
