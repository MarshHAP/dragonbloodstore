<section class="guarantee">
  <div class="container">
    <div class="guarantee__card">
      <div class="guarantee__media">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: alt: section.settings.image.alt }}
        {%- else -%}
          <img src="{{ 'serum-front.jpg' | asset_url }}" alt="Product with packaging" width="880" height="880">
        {%- endif -%}
      </div>
      <div class="guarantee__copy">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <a href="#offer" class="btn btn--primary js-scroll">{{ section.settings.button_label }} <u>Risk-Free</u></a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the bundled product photo." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try Dragonblood" },
    { "type": "text", "id": "text", "label": "Text", "default": "A simple daily ritual for your skin, backed by our 30-Day Money-Back Guarantee." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try Dragonblood" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
