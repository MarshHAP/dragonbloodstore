<section class="press-strip">
  <a class="press-strip__link" href="{{ section.settings.link | default: '/pages/press' }}" aria-label="{{ section.settings.heading | escape }} - see the coverage">
    <div class="container">
      <span class="press-strip__label">{{ section.settings.heading }}</span>
      <div class="press-strip__logos">
        {%- for block in section.blocks -%}
          {%- if block.settings.logo -%}
            {{ block.settings.logo | image_url: width: 400 | image_tag: alt: block.settings.name, loading: 'lazy' }}
          {%- else -%}
            <img src="{{ block.settings.fallback_logo | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" {{ block.shopify_attributes }}>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </a>
</section>

{% schema %}
{
  "name": "Press strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" },
    { "type": "url", "id": "link", "label": "Link", "info": "Where the strip links to. Defaults to the Press page." }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Publication logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication name", "default": "Forbes" },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Shown in white on the dark band." },
        { "type": "text", "id": "fallback_logo", "label": "Fallback asset filename", "default": "press-forbes.svg", "info": "Used when no logo is picked." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Press strip",
      "blocks": [
        { "type": "logo" },
        { "type": "logo", "settings": { "name": "CNN", "fallback_logo": "press-cnn.svg" } },
        { "type": "logo", "settings": { "name": "National Geographic", "fallback_logo": "press-natgeo.svg" } },
        { "type": "logo", "settings": { "name": "PBS NewsHour", "fallback_logo": "press-pbs.svg" } },
        { "type": "logo", "settings": { "name": "Euronews", "fallback_logo": "press-euronews.svg" } },
        { "type": "logo", "settings": { "name": "Fast Company", "fallback_logo": "press-fastco.svg" } }
      ]
    }
  ]
}
{% endschema %}
