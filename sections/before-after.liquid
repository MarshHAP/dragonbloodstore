<section class="ba">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <p class="sci-lead">{{ section.settings.lead }}</p>
    <div class="ba-slider" id="baSlider">
      {%- if section.settings.after_image -%}
        {{ section.settings.after_image | image_url: width: 1100 | image_tag: alt: 'After' }}
      {%- else -%}
        <img src="{{ 'after.jpg' | asset_url }}" alt="Skin after using the serum" width="1100" height="1100">
      {%- endif -%}
      {%- if section.settings.before_image -%}
        {{ section.settings.before_image | image_url: width: 1100 | image_tag: class: 'ba-slider__before', alt: 'Before' }}
      {%- else -%}
        <img class="ba-slider__before" src="{{ 'before.jpg' | asset_url }}" alt="Skin before using the serum" width="1100" height="1100">
      {%- endif -%}
      <div class="ba-slider__bar" aria-hidden="true"></div>
      <div class="ba-slider__grip" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M8 7l-4 5 4 5"/><path d="M16 7l4 5-4 5"/></svg>
      </div>
      <span class="ba-label ba-label--before">{{ section.settings.before_label }}</span>
      <span class="ba-label ba-label--after">{{ section.settings.after_label }}</span>
      <input type="range" class="ba-slider__range" id="baRange" min="0" max="100" value="25" aria-label="Drag to compare before and after">
    </div>
    <p class="ba-caption">{{ section.settings.caption }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Before / after slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the Difference" },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "Drag the slider to compare skin before and after a daily Dragonblood ritual." },
    { "type": "image_picker", "id": "before_image", "label": "Before image", "info": "Falls back to the bundled photo." },
    { "type": "image_picker", "id": "after_image", "label": "After image", "info": "Falls back to the bundled photo." },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Individual results may vary." }
  ],
  "presets": [{ "name": "Before / after slider" }]
}
{% endschema %}
