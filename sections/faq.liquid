<section class="faq">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    <div class="faq__cols">
      {%- assign half = section.blocks.size | plus: 1 | divided_by: 2 -%}
      <div class="accordion accordion--faq">
        {%- for block in section.blocks limit: half -%}
          <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="accordion__body"><p>{{ block.settings.answer }}</p></div>
          </details>
        {%- endfor -%}
      </div>
      <div class="accordion accordion--faq">
        {%- for block in section.blocks offset: half -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="accordion__body"><p>{{ block.settings.answer }}</p></div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is Dragonblood serum?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "A daily anti-ageing serum built around dragon blood extract, ceramide NP and glossy ganoderma, made to repair the skin barrier and restore a healthy glow as part of a daily routine." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Is it suitable for daily use?", "answer": "Yes, it is designed to fit into a simple daily skincare routine, morning and night." } },
        { "type": "question", "settings": { "question": "What if it doesn't work for me?", "answer": "You're covered by our 30-Day Money-Back Guarantee - contact us for a full refund, no questions asked." } },
        { "type": "question", "settings": { "question": "How do I use it?", "answer": "Apply 3–4 drops to clean skin morning and night, then follow with moisturiser and SPF in the morning." } },
        { "type": "question", "settings": { "question": "Can I use it with other skincare?", "answer": "In most routines yes - apply after cleansing, before moisturiser. Introduce gradually if you use strong actives." } }
      ]
    }
  ]
}
{% endschema %}
