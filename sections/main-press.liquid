<section class="press-page">
  <div class="container">
    <h1 class="section-title">{{ section.settings.heading }}</h1>
    <p class="sci-lead">{{ section.settings.lead }}</p>
    <div class="press-grid">
      {%- for block in section.blocks -%}
        <a class="press-card" href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <span class="press-card__logo">
            {%- if block.settings.logo -%}
              {{ block.settings.logo | image_url: width: 400 | image_tag: alt: block.settings.name, loading: 'lazy' }}
            {%- else -%}
              <img src="{{ block.settings.fallback_logo | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
          </span>
          <span class="press-card__title">{{ block.settings.title }}</span>
          <span class="press-card__text">{{ block.settings.text }}</span>
          <span class="press-card__cta">Read the article &#8599;</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Press page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As Seen In" },
    { "type": "textarea", "id": "lead", "label": "Lead", "default": "Dragon's blood - the crimson resin at the heart of our serum - has captured the attention of the world's press. Explore the coverage below." }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Press article",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication name", "default": "Forbes" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "fallback_logo", "label": "Fallback asset filename", "default": "press-forbes.svg" },
        { "type": "text", "id": "title", "label": "Article title" },
        { "type": "textarea", "id": "text", "label": "Blurb" },
        { "type": "url", "id": "url", "label": "Article link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Press page" }]
}
{% endschema %}
